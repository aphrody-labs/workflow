{
  "name": "workflow-workspace",
  "private": true,
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/pre": "^3.0.0",
    "@changesets/read": "^1.0.0",
    "@manypkg/get-packages": "^3.1.0",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "prepare": "husky",
    "build": "turbo build --filter='./packages/*'",
    "test": "turbo test",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "test:e2e": "vitest run packages/core/e2e/e2e.test.ts packages/core/e2e/e2e-agent.test.ts packages/core/e2e/e2e-dynamic-workflow.test.ts",
    "test:e2e:event-log-race-repro": "vitest run packages/core/e2e/event-log-race-repro.test.ts",
    "test:e2e:event-log-race-repro:local": "bash scripts/event-log-race-repro-local.sh",
    "test:e2e:nextjs-webpack:staged": "node scripts/test-staged-nextjs-webpack.mjs",
    "test:docs": "pnpm --filter @workflow/docs-typecheck test:docs",
    "bench": "vitest run packages/core/e2e/benchmark.test.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "changeset": "changeset",
    "ci:version": "changeset version",
    "ci:publish": "pnpm build && changeset publish",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "workbench:stage": "node scripts/stage-workbench.mjs"
  },
  "lint-staged": {
    "**/*": "biome format --write --no-errors-on-unmatched"
  },
  "workspaces": {
    "packages": [
      "workbench/*",
      "!workbench/nitro",
      "packages/*",
      "docs",
      "tarballs"
    ],
    "catalog": {
      "@biomejs/biome": "^2.4.4",
      "@swc/core": "1.15.3",
      "@types/json-schema": "^7.0.15",
      "@types/node": "22.19.21",
      "@vercel/functions": "^3.11.1",
      "@vercel/oidc": "3.2.0",
      "@vercel/queue": "0.10.0",
      "@vitest/coverage-v8": "^5.1.0",
      "ai": "6.0.325",
      "enhanced-resolve": "5.26.1",
      "esbuild": "^0.28.2",
      "nitro": "^3.0.260610-beta",
      "semver": "7.8.6",
      "typescript": "^6.0.3",
      "ulid": "~3.0.2",
      "undici": "7.30.2",
      "vitest": "^5.1.0",
      "zod": "~4.6.7"
    },
    "catalogs": {
      "ai-sdk-v7": {
        "@ai-sdk/openai": "4.0.110",
        "@ai-sdk/react": "4.0.167",
        "@ai-sdk/workflow": "2.0.95",
        "ai": "7.0.163"
      }
    }
  }
}
